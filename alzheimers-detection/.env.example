ALZDX_ENVIRONMENT=development
ALZDX_LOG_LEVEL=INFO

ALZDX_ASR_BACKEND=faster_whisper
ALZDX_ASR_MODEL_SIZE=base
ALZDX_MAX_AUDIO_DURATION_SECONDS=600
ALZDX_MIN_AUDIO_DURATION_SECONDS=3.0
ALZDX_PAUSE_THRESHOLD_SECONDS=0.25

# Point this at your OWN locally-approved DementiaBank/ADReSS copy if you
# have TalkBank access. Never commit real data at this path -- it's
# gitignored. See src/alzheimers_detection/data/loaders/dementiabank.py
ALZDX_DATA_DIR=./data

ALZDX_KEEP_UPLOADED_AUDIO=false
